__pycache__/
*.py[cod]
.venv/
*.egg-info/
.DS_Store
*.db
*.db.gz

# Evaluation labels contain a person's session ids and hand-approved labels.
# The text itself is read from the local databases at run time, never stored here.
tests/eval/labels.json
tests/eval/*.local.json
baseline.json

# Local review exports
tools/*.local.html

# The personal batería is the owner's own experience: it never leaves the machine.
core/bateria.personal.yaml

# Written by tests/test_plugin.mjs on every run
.plugin-under-test.mjs

# Datos de trabajo: backups del dataset (pueden contener texto de sesiones)
tools/sim80_backup_*.json
tools/sim80_pre-redact_*.json

# Correcciones puntuales del dueno
core/corrections.personal.yaml
